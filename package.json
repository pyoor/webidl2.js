{
  "name": "webidl2",
  "description": "A WebIDL Parser",
  "version": "24.4.1",
  "contributors": [
    "Robin Berjon <robin@berjon.com> (https://berjon.com)",
    "Marcos Caceres <marcos@marcosc.com> (https://marcosc.com)",
    "Kagami Sascha Rosylight <saschaplas@outlook.com>",
    "Timothy Gu <timothygu99@gmail.com>"
  ],
  "engines": {
    "node": ">= 14"
  },
  "license": "W3C",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "expect": "^29.7.0",
    "jsondiffpatch": "^0.6.0",
    "mocha": "^10.4.0",
    "prettier": "^3.2.5",
    "terser-webpack-plugin": "^5.3.10",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "scripts": {
    "eslint": "eslint lib test",
    "typecheck": "tsc -p jsconfig.json",
    "lint": "npm run eslint && npm run typecheck",
    "test": "npm run lint && webpack && mocha",
    "acquire": "node test/util/acquire.js",
    "build:node": "tsc -p tsconfig.node.json",
    "build:browser": "tsc -p tsconfig.browser.json && npx webpack",
    "build-debug": "tsc -p tsconfig.browser.json && npx webpack --mode none",
    "build": "npm run build:node && npm run build:browser",
    "prepublishOnly": "npm run build"
  },
  "repository": "git://github.com/w3c/webidl2.js",
  "main": "dist/webidl2.js",
  "exports": {
    ".": {
      "import": "./dist/browser/bundle.js",
      "require": "./dist/node/index.js"
    }
  },
  "type": "module",
  "files": [
    "dist/*",
    "lib/*",
    "index.js"
  ]
}
